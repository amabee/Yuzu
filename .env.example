# Local development only. Use independently generated secrets on a shared server.
POSTGRES_USER=yuzu
POSTGRES_PASSWORD=yuzu-local-development
POSTGRES_DB=yuzu
POSTGRES_PORT=54329
DATABASE_URL=postgresql://yuzu:yuzu-local-development@127.0.0.1:54329/yuzu

# Generate these once with pnpm setup:keys. Never replace keys for an existing installation.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
YUZU_SETUP_KEY=
SETTINGS_ENCRYPTION_KEY=

# Dedicated realtime service. The secret is server-only and generated by setup:keys.
REALTIME_SECRET=
REALTIME_INTERNAL_URL=http://127.0.0.1:3001
REALTIME_PUBLIC_URL=http://127.0.0.1:3001
REALTIME_PORT=3001

# Private local uploads. Empty defaults to apps/web/storage/attachments in development.
# Shared-server deployments should set an absolute persistent directory.
YUZU_UPLOAD_DIR=

# New uploads use private S3 storage; LOCAL is also supported.
# This local directory remains the bounded upload-validation staging area.
YUZU_STORAGE_PROVIDER=S3
YUZU_S3_ENDPOINT=http://127.0.0.1:8333
YUZU_S3_REGION=us-east-1
YUZU_S3_BUCKET=yuzu-attachments
YUZU_S3_PORT=8333
YUZU_S3_FORCE_PATH_STYLE=true
# Generated by setup:keys. Server-only; never expose these to the browser.
YUZU_S3_ACCESS_KEY_ID=
YUZU_S3_SECRET_ACCESS_KEY=

# Local SeaweedFS admin console: http://127.0.0.1:23646
YUZU_SEAWEED_ADMIN_USER=admin
YUZU_SEAWEED_ADMIN_PORT=23646
YUZU_SEAWEED_ADMIN_PASSWORD=
