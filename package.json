{
  "name": "yuzu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:keys": "node scripts/setup-keys.mjs",
    "dev": "pnpm --filter @yuzu/web dev",
    "build": "pnpm db:generate && pnpm --filter @yuzu/web build",
    "start": "pnpm --filter @yuzu/web start",
    "lint": "pnpm --filter @yuzu/web lint",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "test": "pnpm --filter @yuzu/web test",
    "test:e2e": "pnpm --filter @yuzu/web test:e2e",
    "format": "prettier --write --ignore-unknown apps packages docs package.json pnpm-workspace.yaml compose.yaml .github",
    "format:check": "prettier --check --ignore-unknown apps packages docs package.json pnpm-workspace.yaml compose.yaml .github",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @yuzu/database generate",
    "db:migrate": "pnpm --filter @yuzu/database migrate",
    "db:deploy": "pnpm --filter @yuzu/database run deploy",
    "db:check": "pnpm --filter @yuzu/database check",
    "db:upgrade:ids": "pnpm --filter @yuzu/database upgrade:ids"
  },
  "devDependencies": {
    "prettier": "3.7.4"
  }
}
