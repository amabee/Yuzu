generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SetupState {
  UNCLAIMED
  OWNER_CREATED
  EMAIL_VERIFIED
  READY
}

// Named singleton and operational keys remain strings; generated record IDs use UUIDv7.
model InstallationSettings {
  id                         String     @id @default("installation")
  name                       String     @default("Yuzu")
  timezone                   String     @default("UTC")
  defaultDateFormat          String     @default("dd MMM yyyy")
  /// First day of calendar weeks: 0 Sunday, 1 Monday.
  weekStartsOn               Int        @default(1)
  maxAttachmentSizeBytes     Int        @default(50000000)
  allowedAttachmentMimeTypes String[]   @default(["image/jpeg", "image/png", "image/gif", "image/webp", "application/pdf", "text/plain", "text/csv", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.openxmlformats-officedocument.presentationml.presentation"])
  maintenanceMode            Boolean    @default(false)
  theme                      Json?
  themeDraft                 Json?
  previousTheme              Json?
  themeRevision              Int        @default(0)
  setupState                 SetupState @default(UNCLAIMED)
  revision                   Int        @default(1)
  createdAt                  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @db.Timestamptz(3)
  ownerId                    String?    @unique
  owner                      User?      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  emailConfig                String?
  emailConfigRevision        Int        @default(0)
  emailVerifiedRevision      Int?
  verificationDigest         String?
  verificationExpiresAt      DateTime?  @db.Timestamptz(3)
  verificationAttempts       Int        @default(0)
  verificationSentAt         DateTime?  @db.Timestamptz(3)
  initialWorkspaceId         String?    @unique
  initialBoardId             String?    @unique
  /// Lets automation webhooks reach local or private-network addresses.
  allowPrivateWebhooks       Boolean    @default(false)
  /// ISO 4217 code for currency number fields.
  currency                   String     @default("PHP")
  /// Erase Trash items deleted more than this many days ago; null keeps them.
  trashRetentionDays         Int?
}

model User {
  id                      String                   @id @default(uuid(7))
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  role                    String                   @default("MEMBER")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  transfers               CsvTransfer[]
  savedBoardViews         SavedBoardView[]
  boardViewSelections     BoardViewSelection[]
  sessions                Session[]
  accounts                Account[]
  installation            InstallationSettings?
  workspaces              Workspace[]
  memberships             WorkspaceMember[]
  boards                  Board[]
  invitations             Invitation[]             @relation("Inviter")
  managedBoards           BoardManager[]           @relation("BoardManagerUser")
  boardManagerGrants      BoardManager[]           @relation("BoardManagerGrantor")
  boardEvents             BoardEvent[]
  tasksCreated            Task[]                   @relation("TaskCreator")
  taskAssignments         TaskAssignee[]
  taskGrants              TaskEditorGrant[]        @relation("TaskEditor")
  grantsIssued            TaskEditorGrant[]        @relation("TaskGrantor")
  taskActivity            TaskActivity[]
  fieldPeople             TaskFieldPerson[]
  comments                TaskComment[]
  attachments             TaskAttachment[]
  commentRevisions        CommentRevision[]
  accessEvents            AccessEvent[]
  projectsCreated         Project[]                @relation("ProjectCreator")
  projectMemberships      ProjectMember[]          @relation("ProjectMemberUser")
  projectGrants           ProjectMember[]          @relation("ProjectMemberGrantor")
  projectInvitations      ProjectInvitation[]      @relation("ProjectInviter")
  primaryApprovalPolicies BoardApprovalPolicy[]    @relation("PrimaryApprover")
  backupApprovalPolicies  BoardApprovalPolicy[]    @relation("BackupApprover")
  proposalsAuthored       BoardProposal[]          @relation("ProposalAuthor")
  proposalsDecided        BoardProposal[]          @relation("ProposalDecider")
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationsSent       Notification[]           @relation("NotificationActor")
  emailPreferences        NotificationPreference[]
  emailMessages           EmailMessage[]
  /// Daily digest time ("HH:MM", installation timezone); null turns it off.
  digestTime              String?                  @default("08:00")
  lastDigestAt            DateTime?                @db.Timestamptz(3)
  automationRules         AutomationRule[]         @relation("AutomationCreator")
  /// Deactivated people can't sign in; their name stays on their work.
  deactivatedAt           DateTime?                @db.Timestamptz(3)
  deactivatedById         String?
  deactivatedBy           User?                    @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  usersDeactivated        User[]                   @relation("UserDeactivator")
  auditEvents             AuditEvent[]             @relation("AuditActor")
  apiTokens               ApiToken[]               @relation("ApiTokenOwner")
  apiTokensRevoked        ApiToken[]               @relation("ApiTokenRevoker")
}

/// Personal API tokens. Only a SHA-256 digest of the secret is stored.
model ApiToken {
  id             String    @id @default(uuid(7))
  userId         String
  user           User      @relation("ApiTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// The first characters of the token, so people can recognise it.
  prefix         String
  digest         String    @unique
  /// READ or WRITE.
  access         String
  expiresAt      DateTime? @db.Timestamptz(3)
  lastUsedAt     DateTime? @db.Timestamptz(3)
  expiryWarnedAt DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  revokedById    String?
  revokedBy      User?     @relation("ApiTokenRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid(7))
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model SetupClaim {
  id              String   @id @default("owner")
  email           String
  intentDigest    String
  intentExpiresAt DateTime
  createdAt       DateTime @default(now())
}

model AuthenticationAttempt {
  id          String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@index([windowStart])
}

model Workspace {
  id           String            @id @default(uuid(7))
  name         String
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  boards       Board[]
  projects     Project[]
  invitations  Invitation[]
  accessEvents AccessEvent[]
  auditEvents  AuditEvent[]
  companyProfiles CompanyProfile[]
  contactProfiles ContactProfile[]
  /// Archived workspaces are hidden, with their boards, until restored.
  archivedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

/// Installation-wide record of access, people and settings changes.
model AuditEvent {
  id          String     @id @default(uuid(7))
  /// Null for events without a signed-in actor, such as sign-in lockouts.
  actorId     String?
  actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  /// Who or what it was about, kept as text so it survives later changes.
  subject     String
  subjectId   String?
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  details     String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// A specific initiative inside a workspace. PUBLIC projects are visible to every
// workspace member; PRIVATE projects only to their members (not even to admins,
// who can only recover access through an audited action).
model Project {
  id          String              @id @default(uuid(7))
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  color       String
  visibility  String              @default("PUBLIC")
  position    Int
  archivedAt  DateTime?           @db.Timestamptz(3)
  /// In Trash: the project and its boards are hidden until restored.
  deletedAt   DateTime?           @db.Timestamptz(3)
  deletedById String?
  revision    Int                 @default(1)
  createdById String
  createdBy   User                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  invitations ProjectInvitation[]
  boards      Board[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt, position])
}

// Project members may also be project-only people invited from outside the workspace.
model ProjectMember {
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("MEMBER")
  projectOnly Boolean  @default(false)
  grantedById String
  grantedBy   User     @relation("ProjectMemberGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id          String    @id @default(uuid(7))
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("MEMBER")
  invitedById String
  invitedBy   User      @relation("ProjectInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  tokenDigest String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([projectId, email])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Invitation {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User      @relation("Inviter", fields: [invitedById], references: [id], onDelete: Restrict)
  tokenDigest String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([workspaceId, email])
}

model AccessEvent {
  id           String    @id @default(uuid(7))
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       String
  subjectEmail String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
}

model Board {
  /// Independent archive flag; project archiving remains inherited.
  archivedAt       DateTime?            @db.Timestamptz(3)
  id               String               @id @default(uuid(7))
  name             String
  workspaceId      String
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  // Null means a standalone board directly in the workspace.
  projectId        String?
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  position         Int                  @default(0)
  createdById      String
  createdBy        User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  managers         BoardManager[]
  events           BoardEvent[]
  approvalPolicy   BoardApprovalPolicy?
  proposals        BoardProposal[]
  notifications    Notification[]
  transfers        CsvTransfer[]
  savedViews       SavedBoardView[]
  viewSelections   BoardViewSelection[]
  tasks            Task[]
  columns          BoardColumn[]
  groups           BoardGroup[]
  automationRules  AutomationRule[]
  automationEvents AutomationEvent[]
  /// TASK, DEAL, CUSTOM, or a workspace's COMPANY/CONTACT collection
  /// (lib/record-types.ts). Fixed after creation.
  recordType       String               @default("TASK")
  /// Names and built-in field switches, validated by recordConfigSchema.
  recordConfig     Json                 @default("{}")
  /// In Trash: the board and its records are hidden until restored.
  deletedAt        DateTime?            @db.Timestamptz(3)
  deletedById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([workspaceId])
  @@index([projectId, position])
  @@index([workspaceId, archivedAt])
}

model BoardColumn {
  id         String           @id @default(uuid(7))
  boardId    String
  board      Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  key        String
  name       String
  type       String
  position   Int
  config     Json             @default("{}")
  archivedAt DateTime?        @db.Timestamptz(3)
  values     TaskFieldValue[]
  links      RecordLink[]

  @@unique([boardId, key])
}

/// A link between two records through a "Link to board" field. One row
/// serves both sides: the field's mirror on the other board reads it in reverse.
model RecordLink {
  id          String      @id @default(uuid(7))
  /// The field that owns the link (the one created first, not its mirror).
  fieldId     String
  field       BoardColumn @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fromId      String
  from        Task        @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          Task        @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([fieldId, fromId, toId])
  @@index([fieldId, toId])
  @@index([toId])
}

model BoardGroup {
  id       String @id @default(uuid(7))
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  position Int
  tasks    Task[]

  @@index([boardId])
}

model Task {
  /// One-level Task-only breakdown. Public creation remains gated.
  parentId               String?
  parent                 Task?             @relation("TaskChildren", fields: [boardId, parentId], references: [boardId, id], onDelete: Restrict, onUpdate: Cascade, map: "Task_parent_fk")
  children               Task[]            @relation("TaskChildren")
  childrenRevision       Int               @default(0)
  childCreationProposals BoardProposal[]   @relation("SubitemCreationParent")
  id                     String            @id @default(uuid(7))
  boardId                String
  board                  Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name                   String
  description            String            @default("")
  checklist              Json              @default("[]")
  statusId               String?
  priority               String            @default("NORMAL")
  startDate              DateTime?         @db.Date
  dueDate                DateTime?         @db.Date
  groupId                String?
  group                  BoardGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  /// Manual order on the board; lanes and lists sort by it.
  position               Float             @default(0)
  createdById            String
  createdBy              User              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createKey              String
  createDigest           String
  revision               Int               @default(1)
  archivedAt             DateTime?         @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)
  assignees              TaskAssignee[]
  editors                TaskEditorGrant[]
  values                 TaskFieldValue[]
  activity               TaskActivity[]
  comments               TaskComment[]
  attachments            TaskAttachment[]
  proposals              BoardProposal[]   @relation("TaskProposals")
  notifications          Notification[]
  automationEvents       AutomationEvent[]
  automationRuns         AutomationRun[]
  linksFrom              RecordLink[]      @relation("LinkFrom")
  linksTo                RecordLink[]      @relation("LinkTo")
  /// Company/Contact boards only: the record's customer fields.
  companyProfile         CompanyProfile?
  contactProfile         ContactProfile?
  /// In Trash: hidden everywhere until restored (docs/specs/trash.md).
  deletedAt              DateTime?         @db.Timestamptz(3)
  deletedById            String?

  @@unique([boardId, id])
  @@unique([createdById, createKey])
  @@index([parentId, position, id])
  @@index([boardId, archivedAt, createdAt, id])
  @@index([boardId, archivedAt, position, id])
  @@index([boardId, archivedAt, dueDate, id])
  @@index([boardId, archivedAt, startDate, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Task_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Task_description_trgm_idx")
  @@index([boardId, statusId])
  @@index([deletedAt])
}

/// Customer fields of a record on the workspace's Companies collection
/// (docs/specs/companies-contacts.md). Triggers keep it on a COMPANY board in
/// the same workspace; the record's board columns are adapters to these values.
model CompanyProfile {
  recordId    String    @id
  record      Task      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  legalName   String?
  website     String?
  /// Lowercase ASCII hostname, without scheme or path.
  domain      String?
  email       String?
  /// Case-folded email: an advisory duplicate key, never a uniqueness rule.
  emailKey    String?
  phone       String?
  address     String?
  /// People linked to this company; the contact side owns each link.
  people      ContactCompany[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([recordId, workspaceId])
  @@index([workspaceId, domain])
  @@index([workspaceId, emailKey])
}

/// Customer fields of a record on the workspace's Contacts collection.
model ContactProfile {
  recordId    String    @id
  record      Task      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  email       String?
  emailKey    String?
  phone       String?
  /// Changes whenever the primary company changes, independently of the
  /// record's own revision, so concurrent primary choices can't overwrite.
  primaryRevision Int       @default(0)
  companies   ContactCompany[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([recordId, workspaceId])
  @@index([workspaceId, emailKey])
}

/// A contact's link to a company: role, current or former, and at most one
/// primary per contact. Both ends are in the same workspace (composite keys);
/// SQL constraints enforce the status and primary rules.
model ContactCompany {
  id          String         @id @default(uuid(7))
  workspaceId String
  contactId   String
  contact     ContactProfile @relation(fields: [contactId, workspaceId], references: [recordId, workspaceId], onDelete: Cascade)
  companyId   String
  company     CompanyProfile @relation(fields: [companyId, workspaceId], references: [recordId, workspaceId], onDelete: Cascade)
  role        String?
  /// CURRENT or FORMER.
  status      String         @default("CURRENT")
  isPrimary   Boolean        @default(false)
  revision    Int            @default(1)
  createdById String
  updatedById String
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([contactId, companyId])
  @@index([companyId, status, id])
  @@index([contactId, status, id])
}

/// Replays of link commands: the same key and payload return the recorded
/// result; a different payload under the same key is refused.
model AffiliationRequest {
  actorId    String
  requestKey String
  digest     String
  result     Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([actorId, requestKey])
}

model TaskAttachment {
  id              String    @id @default(uuid(7))
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadKey       String
  storageKey      String    @unique
  storageProvider String    @default("LOCAL")
  storageBucket   String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  sha256          String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  removedAt       DateTime? @db.Timestamptz(3)

  @@unique([taskId, uploadedById, uploadKey])
  @@index([taskId, removedAt, createdAt])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskEditorGrant {
  taskId      String
  userId      String
  grantedById String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation("TaskEditor", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation("TaskGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([taskId, userId])
}

model TaskFieldValue {
  id           String            @id @default(uuid(7))
  taskId       String
  fieldId      String
  task         Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field        BoardColumn       @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  textValue    String?
  numberValue  Float?
  booleanValue Boolean?
  dateValue    DateTime?         @db.Date
  choices      String[]          @default([])
  people       TaskFieldPerson[]

  @@unique([taskId, fieldId])
  @@index([fieldId])
  @@index([fieldId, numberValue])
  @@index([fieldId, dateValue])
}

model TaskFieldPerson {
  valueId String
  userId  String
  value   TaskFieldValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([valueId, userId])
}

model TaskActivity {
  id        String   @id @default(uuid(7))
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  revision  Int
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([taskId, revision])
}

model BoardManager {
  boardId     String
  userId      String
  grantedById String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user        User     @relation("BoardManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation("BoardManagerGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([boardId, userId])
}

model BoardEvent {
  id        String   @id @default(uuid(7))
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  subjectId String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([boardId, createdAt])
}

model TaskComment {
  id           String            @id @default(uuid(7))
  taskId       String
  task         Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createKey    String
  body         String
  revision     Int               @default(1)
  createDigest String?
  mentions     Json              @default("[]")
  deletedAt    DateTime?         @db.Timestamptz(3)
  revisions    CommentRevision[]
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([taskId, authorId, createKey])
  @@index([taskId, createdAt])
}

model CommentRevision {
  id        String      @id @default(uuid(7))
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  revision  Int
  action    String
  body      String
  mentions  Json
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([commentId, revision])
}

enum ApprovalOperation {
  CREATE
  UPDATE
  ARCHIVE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  STALE
}

model BoardApprovalPolicy {
  boardId           String   @id
  board             Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(false)
  requireCreation   Boolean  @default(false)
  requireChanges    Boolean  @default(true)
  requireArchive    Boolean  @default(false)
  protectedFieldIds String[] @default([])
  primaryApproverId String?
  primaryApprover   User?    @relation("PrimaryApprover", fields: [primaryApproverId], references: [id], onDelete: SetNull)
  backupApproverId  String?
  backupApprover    User?    @relation("BackupApprover", fields: [backupApproverId], references: [id], onDelete: SetNull)
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

model BoardProposal {
  id              String            @id @default(uuid(7))
  boardId         String
  board           Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?             @relation("TaskProposals", fields: [taskId], references: [id], onDelete: SetNull)
  parentTaskId    String?
  parentTask      Task?             @relation("SubitemCreationParent", fields: [boardId, parentTaskId], references: [boardId, id], onDelete: Restrict, onUpdate: Cascade, map: "BoardProposal_parent_fk")
  authorId        String
  author          User              @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  operation       ApprovalOperation
  status          ProposalStatus    @default(PENDING)
  requestKey      String
  requestDigest   String
  changes         Json
  baseline        Json
  policySnapshot  Json
  policyVersion   Int
  sourceRevision  Int?
  appliedRevision Int?
  decidedById     String?
  decidedBy       User?             @relation("ProposalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  reason          String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  decidedAt       DateTime?         @db.Timestamptz(3)
  notifications   Notification[]

  @@unique([authorId, requestKey])
  @@index([parentTaskId, status])
  @@index([boardId, status, createdAt])
  @@index([authorId, status, createdAt])
}

enum NotificationKind {
  MENTION
  ASSIGNMENT
  APPROVAL_REQUEST
  APPROVAL_DECISION
  AUTOMATION
}

model Notification {
  id          String           @id @default(uuid(7))
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  boardId     String
  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  proposalId  String?
  proposal    BoardProposal?   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  message     String
  eventKey    String
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  readAt      DateTime?        @db.Timestamptz(3)

  @@unique([recipientId, eventKey])
  @@index([recipientId, readAt, id])
  @@index([boardId])
}

model SavedBoardView {
  id         String               @id @default(uuid(7))
  boardId    String
  board      Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  visibility String               @default("PERSONAL")
  config     Json
  revision   Int                  @default(1)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  selections BoardViewSelection[]

  @@index([boardId, ownerId])
}

model BoardViewSelection {
  boardId String
  board   Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewId  String?
  view    SavedBoardView? @relation(fields: [viewId], references: [id], onDelete: SetNull)

  @@id([boardId, userId])
  @@index([viewId])
}

// Durable user-facing transfer state; queue scheduling lives in pg-boss's own schema.
model CsvTransfer {
  id          String             @id @default(uuid(7))
  ownerId     String
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardId     String
  board       Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  kind        String
  name        String
  status      String             @default("UPLOADING")
  total       Int
  done        Int                @default(0)
  chunkCount  Int                @default(0)
  config      Json
  error       String?
  filename    String?
  outputKey   String?
  queueId     String             @unique @default(uuid(7))
  enqueuedAt  DateTime?          @db.Timestamptz(3)
  finishedAt  DateTime?          @db.Timestamptz(3)
  dismissedAt DateTime?          @db.Timestamptz(3)
  expiresAt   DateTime           @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  chunks      CsvTransferChunk[]
  rows        CsvTransferRow[]

  @@index([ownerId, dismissedAt, createdAt])
  @@index([status, enqueuedAt])
}

model CsvTransferChunk {
  transferId String
  transfer   CsvTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  index      Int
  count      Int
  bytes      Int
  digest     String
  objectKey  String

  @@id([transferId, index])
}

model CsvTransferRow {
  transferId String
  transfer   CsvTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  row        Int
  outcome    String
  taskId     String?
  proposalId String?
  message    String?

  @@id([transferId, row])
}

/// A board rule: When (trigger) / If (conditions) / Then (actions).
/// It runs as its creator; see docs/specs/automation.md.
model AutomationRule {
  id                  String               @id @default(uuid(7))
  boardId             String
  board               Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name                String
  enabled             Boolean              @default(true)
  recordScope         String               @default("ROOTS")
  trigger             Json
  /// "all" or "any": how the conditions combine.
  match               String               @default("all")
  conditions          Json                 @default("[]")
  actions             Json
  createdById         String
  createdBy           User                 @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revision            Int                  @default(1)
  pausedReason        String?
  consecutiveFailures Int                  @default(0)
  /// Signs webhook deliveries; encrypted with the settings key.
  webhookSecret       String?
  /// The last schedule occurrence that was queued, so it fires once.
  lastScheduledAt     DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  runs                AutomationRun[]
  deliveries          AutomationDelivery[]

  @@index([boardId, enabled])
}

/// Outbox of task changes and due dates waiting for rules to run.
model AutomationEvent {
  id          String          @id @default(uuid(7))
  boardId     String
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Null for scheduled events, which aren't about a task.
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Set for scheduled events: only this rule runs them.
  ruleId      String?
  kind        String
  payload     Json            @default("{}")
  actorId     String?
  depth       Int             @default(0)
  chain       String[]        @default([])
  dedupeKey   String?         @unique
  attempts    Int             @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  processedAt DateTime?       @db.Timestamptz(3)
  runs        AutomationRun[]

  @@index([processedAt, createdAt])
}

enum AutomationOutcome {
  APPLIED
  SKIPPED
  PENDING_APPROVAL
  FAILED
}

model AutomationRun {
  id            String               @id @default(uuid(7))
  ruleId        String
  rule          AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventId       String
  event         AutomationEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// A task this run created, possibly on another board.
  createdTaskId String?
  outcome       AutomationOutcome
  detail        String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  deliveries    AutomationDelivery[]

  @@unique([ruleId, eventId])
  @@index([ruleId, createdAt])
}

enum AutomationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// A webhook POST queued by a run and sent after it commits, with retries.
model AutomationDelivery {
  id            String                   @id @default(uuid(7))
  runId         String
  run           AutomationRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  ruleId        String
  rule          AutomationRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  url           String
  payload       Json
  status        AutomationDeliveryStatus @default(PENDING)
  attempts      Int                      @default(0)
  responseCode  Int?
  durationMs    Int?
  error         String?
  nextAttemptAt DateTime                 @default(now()) @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([runId])
}

enum EmailDelivery {
  INSTANT
  DIGEST
  OFF
}

/// How one person wants one kind of notification by email; absent means the
/// default for that kind.
model NotificationPreference {
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind     NotificationKind
  delivery EmailDelivery

  @@id([userId, kind])
}

enum EmailStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

/// An email waiting for the worker: an instant notification (rendered when it
/// is sent, so a notification read meanwhile is skipped), a digest, or a rule.
model EmailMessage {
  id             String      @id @default(uuid(7))
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "instant", "digest" or "rule".
  purpose        String
  /// The notification an instant email is about.
  notificationId String?
  subject        String?
  html           String?
  text           String?
  status         EmailStatus @default(QUEUED)
  sendAfter      DateTime    @default(now()) @db.Timestamptz(3)
  attempts       Int         @default(0)
  error          String?
  sentAt         DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  @@index([status, sendAfter])
  @@index([userId, sentAt])
}
